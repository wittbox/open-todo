# Copy to .env and fill in. Never commit .env.
#
# With docker compose you need four values to start: POSTGRES_PASSWORD, APP_BASE_URL,
# SESSION_SECRET and CRON_KEY. Everything else has a working default.

# ── Docker compose ──────────────────────────────────────────────
# The database password. Any long random string:  openssl rand -hex 24
POSTGRES_PASSWORD=
# The port the app listens on, for the reverse proxy to forward to. Default: 3000.
APP_PORT=

# ── Database ────────────────────────────────────────────────────
# Local dev: `npm run db:dev` prints a URL — paste it here.
# Docker:    set by docker-compose.yml (postgres://todo:<password>@db:5432/todo).
DATABASE_URL=
SHADOW_DATABASE_URL=
# Connection pool size (default 10). Lower it if a small local dev database runs out of connections.
DATABASE_POOL_MAX=

# ── App ─────────────────────────────────────────────────────────
# Public URL of this install. Used for links in email and for OAuth callbacks.
APP_BASE_URL=http://localhost:3000

# What this install is called, in page titles and email. Default: open-todo.
# An administrator can also change it in /admin, which wins over this.
APP_NAME=

# Session signing key, at least 32 bytes:  openssl rand -hex 32
SESSION_SECRET=

# The first person to sign up becomes the administrator, and that door closes for good.
# On a server reachable from the internet, set this so only that address can claim it.
ADMIN_BOOTSTRAP_EMAIL=

# Defaults for people who haven't picked their own in settings.
# Language (ko | en), used when the browser asks for one we don't have. Default: ko.
DEFAULT_LOCALE=
# IANA time zone, e.g. Asia/Seoul, America/New_York. Decides "today" and the 8am digest. Default: Asia/Seoul.
APP_TZ=
# Public holidays shown on the calendar: kr (South Korea) or none. Default: kr.
HOLIDAY_REGION=

# Behind a reverse proxy (Caddy, nginx)? The number of proxies in front of the app, usually 1.
# Sign-in rate limits then use the visitor's IP from X-Forwarded-For. Leave empty if the app is exposed directly.
TRUST_PROXY=

# ── Sign in with Google (optional) ──────────────────────────────
# The button appears once both values are set. Callback URL to register with Google:
#   {APP_BASE_URL}/auth/google/callback
# (Kakao and NAVER are not available yet.)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (SMTP) ────────────────────────────────────────────────
# Needed for sign-up confirmation, password reset, the morning digest and report mail.
# Any SMTP server works: your company's, Gmail with an app password, SES, Mailgun…
# Port 465 uses SSL/TLS; 587 (default) must support STARTTLS. Check with: npm run mail:test -- you@example.com
SMTP_HOST=
SMTP_PORT=587
# 1 = TLS from the first byte (port 465). Leave empty: on for 465, STARTTLS everywhere else.
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# The sender. Most servers only let you send as the account you log in with, so use that address.
# Report mail shows the author's name ("Jane Doe (open-todo)") and replies go to the author.
MAIL_FROM="open-todo <todo@example.com>"
# Report mail limits per person: recipients per send, and recipients per 24 hours.
REPORT_MAIL_MAX_RECIPIENTS=10
REPORT_MAIL_DAILY_LIMIT=100

# ── Development only ────────────────────────────────────────────
# 1 = write emails to tmp/mail/*.html instead of sending them.
# Without SMTP_HOST, development does this anyway; production refuses to send.
MOCK_MAIL=

# ── Attachments ─────────────────────────────────────────────────
# Defaults to ./data/uploads. docker-compose mounts /app/uploads.
UPLOAD_DIR=

# ── Scheduled jobs ──────────────────────────────────────────────
# Key for /api/cron/* (reminders, morning digest, scheduled report mail).
# Leave empty to keep those endpoints closed.   openssl rand -hex 32
CRON_KEY=
