{
  "name": "open-todo",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "engines": {
    "node": ">=24.7"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "db:dev": "prisma dev --name open-todo",
    "start": "next start",
    "lint": "eslint",
    "check:i18n": "tsx scripts/check-i18n.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "mail:test": "tsx scripts/mail-test.ts",
    "db:reset": "prisma migrate reset --force"
  },
  "dependencies": {
    "@date-fns/tz": "^1.4.1",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@react-pdf/renderer": "^4.9.0",
    "@tanstack/react-query": "^5.90.2",
    "@zxcvbn-ts/language-common": "^4.1.3",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "fractional-indexing": "^3.2.0",
    "jose": "^6.1.0",
    "next": "^16.3.5",
    "next-intl": "^4.14.5",
    "nodemailer": "^10.0.10",
    "pg": "^8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24.13.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.21.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "^16.3.5",
    "jsdom": "^30.0.1",
    "pdfjs-dist": "^6.3.289",
    "prisma": "^7.9.1",
    "tailwindcss": "^4",
    "tsx": "^4.20.6",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": false,
    "@prisma/engines@7.9.1": true,
    "@swc/core@1.16.2": false,
    "esbuild@0.28.2": true,
    "prisma@7.9.1": true,
    "unrs-resolver@1.12.2": true
  }
}
