# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files — 실제 값은 절대 커밋하지 않는다. 예시 파일만 예외.
.env*
!.env.example

# 작업용 화면 미리보기 — 저장소에 넣지 않는다
/preview/

# prisma generate 결과물 (빌드 때 다시 만든다)
/app/generated

# 메일 목 발송 덤프
/tmp

# 서버 DB 볼륨이 로컬로 딸려오는 것 방지
/data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/app/generated/prisma

